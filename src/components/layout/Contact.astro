---
    const { cod } = Astro.props;
---
<!-- contact-area -->
<section
    id="contact"
    class="p-relative pt-65 pb-70 contact-area contact-bg fix"
>
    <div class="container">
    <div class="justify-content-center row">
        <div class="col-xl-8">
        <div
            class="mb-40 text-center section-title wow fadeInDown animated"
            data-animation="fadeInDown animated"
            data-delay=".2s"
        >
            <h2>O cenário perfeito para o seu próximo capítulo</h2>
            <h3>Conheça imóveis únicos nas <br /> melhores regiões do ABC Paulista.</h3>
            <p>
            Nós cuidamos dos imóveis — e também da sua integração à cidade.
            </p>
        </div>
        </div>
    </div>
    <div class="row">
        <div class="col-lg-8 offset-lg-2">
        <form
            action="#"
            class="contact-form wow fadeInUp animated"
            data-animation="fadeInDown animated"
            data-delay=".2s"
            method="post"
            id="form"
        >

            <div class="row">

                <input type="hidden" value={cod} name="CodigoImovel"/>

                <div class="col-lg-12">
                    <div class="p-relative mb-40 contact-field c-name">
                    <input type="text" placeholder="Nome*" name="Nome" required/>
                    </div>
                </div>
                <div class="col-lg-12">
                    <div class="p-relative mb-40 contact-field c-email">
                    <input type="text" placeholder="Telefone*" name="Telefone" required/>
                    </div>
                </div>
                <div class="col-lg-12">
                    <div class="p-relative mb-45 contact-field c-message">
                        <textarea
                            name="Mensagem"
                            placeholder="Mensagem*" 
                            required
                        ></textarea>
                    </div>
                    <button class="btn pulse ss-btn" type="submit" id="btn">
                        Iniciar atendimento personalizado agora.
                    </button>
                </div>
                <p id="status" class="form-status"></p>
            </div>
        </form>
        </div>
    </div>
    </div>
</section>
<!-- contact-area-end -->

<script>
    const form = document.getElementById('form');
    const btn = document.getElementById('btn');
    const status = document.getElementById('status');

    form.addEventListener('submit', async (e) => {
        e.preventDefault();

        const formData = new FormData(form);

        btn.disabled = true;
        btn.textContent = 'Enviando...';
        status.textContent = '';

        try {
            const response = await fetch('https://hooks.zapier.com/hooks/catch/19811820/upfrdwh/', {
                method: 'POST',
                body: formData
            });

            if (response.ok) {
                status.textContent = 'Mensagem enviada com sucesso!';
                form.reset();
            } else {
                throw new Error('Erro na requisição');
            }

        } catch (error) {
            status.textContent = 'Erro ao enviar. Tente novamente.';
            console.error(error);
        }

        btn.disabled = false;
        btn.textContent = 'Iniciar atendimento personalizado agora.';
    });
</script>