    //console.log(miniSearch.search('ap6542'));
    //console.log(miniSearch.getStoredFields(indexData));



    //Acho qe o titulo eu nao vou trazer
    // const miniSearch = MiniSearch.loadJSON(indexData, {
    //   fields: ['id', 'titulo', 'cidade', 'bairro', 'regiao', 'condominio', 'descricao'],
    //   searchOptions: {
    //     fuzzy: 0.2,
    //     prefix: true,
    //     boost: { titulo: 3, condominio: 2.5, bairro: 2, cidade: 1.5, regiao: 1.2, descricao: 0.8 },
    //     combineWith: 'AND'
    //   }
    // });
  </script>
</Layout>