---
import imoveis from '../../../public/data/single.json';
import Layout from '../../layouts/Layout.astro';
import { getImage } from 'astro:assets';
import bgHeaderPath from '../../assets/images/testmonial-bg.webp';
import Contact from "../../components/layout/Contact.astro";

const bgHeader = await getImage({ src: bgHeaderPath });


export async function getStaticPaths() {
  return imoveis.map((imovel) => {
    return {
      params: { slug: imovel.slug },
      props: { imovel },
    };
  });
}

const { slug } = Astro.params;
const { imovel } = Astro.props;
---

<Layout title={imovel.titulo}>
  <!-- main-area -->
  <main>
    <!-- breadcrumb-area -->
    <section
      class="d-flex align-items-center breadcrumb-area"
      style={`background-image: url(${bgHeader.src});`}
    >
      <div class="container">
        <div class="row">
          <div class="col-xl-8 offset-xl-2 col-lg-8 offset-lg-2">
            <div class="text-center breadcrumb-wrap">
              <div class="mb-30 breadcrumb-title">
                <h2>{imovel.titulo}</h2>
              </div>
              <nav aria-label="breadcrumb">
                <ol class="breadcrumb">
                  <li class="breadcrumb-item">
                    <a href="/">Home</a>
                  </li>
                  <li class="breadcrumb-item active" aria-current="page">
                    Imóvel
                  </li>
                </ol>
              </nav>
            </div>
          </div>
        </div>
      </div>
    </section>
    <!-- breadcrumb-area-end -->

    <!-- choose-area -->
    <section class="p-relative pt-120 pb-120 choose-area" id="imovel">
      <div
        class="chosse-img wow fadeInRight animated"
        data-animation="fadeInRight animated"
        data-delay=".2s"
      ></div>
      <div class="container">
        <div class="row">
          <div class="col-xl-6">
            <div class="p-relative mb-30 s-about-img-single photo-gallery">
              <!-- sem foto: http://localhost:4321/imoveis/cobertura-residencial-vila-marlene-sao-bernardo-do-campo-co0607 -->
              <!-- uma foto (principal): http://localhost:4321/imoveis/terreno-padrao-rudge-ramos-sao-bernardo-do-campo-te0789 -->
              {
                Array.isArray(imovel.fotos) && imovel.fotos.length > 0
                  ? imovel.fotos.map((foto) => (
                      <a class="slide popup-image" href={foto.URLArquivo}>
                        <img src={foto.URLArquivo} alt="Foto do imóvel" />
                      </a>
                    ))
                  : imovel.fotos?.URLArquivo
                    ? (
                      <a class="slide popup-image" href={imovel.fotos.URLArquivo}>
                        <img src={imovel.fotos.URLArquivo} alt="Foto do imóvel" />
                      </a>
                    )
                    : (
                      <a class="slide popup-image" href="/images/fallback.jpg">
                        <img src="/images/fallback.jpg" alt="Foto do imóvel" />
                      </a>
                    )
              }
            </div>
          </div>
          <div class="col-xl-6">
            <div class="choose-wrap">
              <div
                class="left-align w-title section-title wow fadeInDown animated"
                data-animation="fadeInDown animated"
                data-delay=".2s"
              >
                <h2 class="choose-title">{imovel.tituloImovel}</h2>
                <h3 class="choose-subtitle">{imovel.cidade}</h3>
              </div>
              <br />
              <div
                class="choose-content wow fadeInUp animated"
                data-animation="fadeInDown animated"
                data-delay=".2s"
              >
                <div class="mt-20 mb-20 choose-list">
                  <ul>
                    { imovel.areaUtil  &&
                    <li>
                      <i class="ph ph-arrows-out"></i>
                      <span>
                        <strong>Área útil</strong> <br />
                        {imovel.areaUtil} m²
                      </span>
                    </li>
                    }
                    { imovel.areaTotal  &&
                    <li>
                      <i class="ph ph-arrows-out"></i>
                      <span>
                        <strong>Área total</strong><br />
                        {imovel.areaTotal} m²
                      </span>
                    </li>
                    }
                    {imovel.qtdDormitorios != 0 &&
                    <li>
                      <i class="ph ph-bed"></i>
                      <span>
                        <strong>Quartos</strong><br />
                        {imovel.qtdDormitorios}
                      </span>
                    </li>
                    }
                    {imovel.qtdSuites &&
                    <li>
                      <i class="ph ph-bathtub"></i>
                      <span>
                        <strong>Suítes</strong><br />
                        {imovel.qtdSuites}
                      </span>
                    </li>
                    }

                    {imovel.qtdBanheiros &&
                    <li>
                      <i class="ph ph-shower"></i>
                      <span>
                        <strong>Banheiros</strong><br />
                        {imovel.qtdBanheiros}
                      </span>
                    </li>
                    }

                    {imovel.qtdVagas &&
                    <li>
                      <i class="ph ph-car"></i>
                      <span>
                        <strong>Vagas</strong><br />
                        {imovel.qtdVagas}
                      </span>
                    </li>
                    }

                    {imovel.aceitaPet &&
                    <li>
                      <i class="ph ph-paw-print"></i>
                      <span>
                        <strong>Aceita pet</strong><br />
                        {imovel.aceitaPet}
                      </span>
                    </li>
                    }
                  </ul>
                </div>

                <div style="display: none;">
                COnd. R$ {imovel.precoCondominio} <br />
                IPTU R$ {imovel.precoIptu} <br />
                </div>

                <ul class="choose-prices">
                  {  imovel.precoVenda && 
                  <li>
                    <h3 class="title">Venda</h3>
                    <h2>
                      {new Intl.NumberFormat('pt-BR', {
                        style: 'currency',
                        currency: 'BRL'
                      }).format(imovel.precoVenda)}
                    </h2>
                  </li>
                  }

                  { imovel.precoLocacao && 
                  <li>
                    <h3 class="title">Locação</h3>
                    <h2>
                      {new Intl.NumberFormat('pt-BR', {
                        style: 'currency',
                        currency: 'BRL'
                      }).format(imovel.precoLocacao)}
                    </h2>
                  </li>
                  }
                  
                </ul>

                <div class="mt-30 choose-btn">
                  <button data-yf-popup="BAEg53y" class="btn pulse">
                    Fale com um especialista
                  </a>
                </div>
              </div>
            </div>
          </div>
          <div class="col-xl-12 content">
            <p>
              {imovel.obs}
            </p>
          </div>
        </div>
      </div>
    </section>
    <!-- choose-area-end -->

    {imovel.latitude != 0 &&
      <iframe 
        width="100%"
        height="500"
        class="gmap_iframe"
        frameborder="0"
        scrolling="no"
        marginheight="0"
        marginwidth="0"
        src={`https://maps.google.com/maps?q=${imovel.latitude},${imovel.longitude}&z=16&output=embed`}
      ></iframe>
    }

    <!-- contact-area -->
    <Contact cod={imovel.id} />
    <!-- contact-area-end -->
  </main>
  <!-- main-area-end -->
</Layout>